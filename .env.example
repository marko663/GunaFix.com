# Resend (https://resend.com) is used to deliver contact form & booking
# submissions by email. Without it, submissions are logged to the server
# console instead of being emailed.
RESEND_API_KEY=

# Where contact form / booking submissions are sent. Defaults to the email
# in src/data/content.ts if not set.
CONTACT_EMAIL=markoguna9@gmail.com

# The "from" address used when sending via Resend. Must be a domain you've
# verified in Resend, otherwise leave the default sandbox sender.
CONTACT_FROM_EMAIL="GunaFix <onboarding@resend.dev>"

# /dashboard — a live, password-gated view onto the growth agents' GitHub
# Issues board (leads, drafts, social content, search/traffic digests,
# permission requests). See automation/README.md for the underlying system.
# Without DASHBOARD_PASSWORD set, the page just says it's not configured.

# Shared password that gates /dashboard. Pick a long random string — there's
# no per-user login, this is the only secret standing in front of the page.
DASHBOARD_PASSWORD=

# A GitHub token with Issues read/write on this repo (classic token with
# `repo` scope, or fine-grained with "Issues: Read and write"), from
# https://github.com/settings/tokens. Same credential the dashboard's
# server actions use to read/comment/label/close issues.
GH_TOKEN=

# owner/repo the dashboard reads from. Defaults to marko663/gunafix.com.
GITHUB_REPOSITORY=marko663/gunafix.com
