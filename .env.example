# Resend (https://resend.com) is used to deliver contact form & booking
# submissions by email. Without it, submissions are logged to the server
# console instead of being emailed.
RESEND_API_KEY=

# Where contact form / booking submissions are sent. Defaults to the email
# in src/data/content.ts if not set.
CONTACT_EMAIL=markoguna9@gmail.com

# The "from" address used when sending via Resend. Must be a domain you've
# verified in Resend, otherwise leave the default sandbox sender.
CONTACT_FROM_EMAIL="GunaFix <onboarding@resend.dev>"

# /dashboard — a live, password-gated view onto the growth agents' GitHub
# Issues board (leads, drafts, social content, search/traffic digests,
# permission requests). See automation/README.md for the underlying system.
# Without DASHBOARD_PASSWORD set, the page just says it's not configured.

# Shared password that gates /dashboard. Pick a long random string — there's
# no per-user login, this is the only secret standing in front of the page.
DASHBOARD_PASSWORD=

# A GitHub token used for everything the dashboard does: reading/writing
# Issues (the leads/drafts/permissions board), reading workflow run status
# and triggering workflow_dispatch (Agents section), and reading/writing
# Actions secrets & variables (Credentials checklist + setup assistant chat).
# Needs a classic token with the `repo` scope (covers all of the above), or
# a fine-grained token with Issues: Read and write, Actions: Read and write,
# and Secrets/Variables: Read and write. From https://github.com/settings/tokens.
GH_TOKEN=

# owner/repo the dashboard reads from. Defaults to marko663/gunafix.com.
GITHUB_REPOSITORY=marko663/gunafix.com

# Anthropic API key used by the dashboard's "Setup assistant" chat to match
# pasted credentials to the right GitHub Actions secret/variable and write
# them for you. Get one from https://console.anthropic.com. This is a
# separate, website-only credential from the same-named secret the
# automation/ agents themselves use at runtime — set both if you want the
# chat AND the agents to work.
ANTHROPIC_API_KEY=

# --- Redaktionssystem / CMS (Sanity) -------------------------------------
# Leave empty to run the site from the built-in dictionaries in src/data.
# Fill in after creating a free project at https://sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# Only needed once, to run scripts/sanity-seed.mjs. Never commit this.
SANITY_WRITE_TOKEN=
