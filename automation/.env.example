# Copy to .env.local for local testing (then `export $(cat .env.local | xargs)`
# or use a tool like `dotenv-cli`). In production these are GitHub Actions
# secrets/variables — see automation/README.md for the full setup checklist.
# Every value here is optional: each agent skips whatever it doesn't have
# credentials for and logs why, instead of crashing.

# --- Identity ---
BUSINESS_NAME=GunaFix
BUSINESS_URL=https://gunafix.com
OWNER_NAME=Marko
OWNER_EMAIL=markoguna9@gmail.com
SENDER_EMAIL=
# Required by US CAN-SPAM law (and good practice elsewhere) once outreach
# sends real commercial email
BUSINESS_PHYSICAL_ADDRESS=
# IANA tz e.g. America/New_York — required for outreach to auto-book a
# meeting slot (business hours, 9am-5pm) when a lead replies. No default.
OWNER_TIMEZONE=

# --- Anthropic (drafts outreach copy, audit write-ups, social scripts) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_FAST_MODEL=claude-haiku-4-5

# --- GitHub (lead board + run log; GH_TOKEN/GITHUB_REPOSITORY are auto-set in Actions) ---
GH_TOKEN=
GITHUB_REPOSITORY=

# --- Google Places (lead sourcing) ---
GOOGLE_PLACES_API_KEY=

# --- Gmail OAuth2 (real outreach sends + leader urgent emails) ---
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# --- GA4 Data API (traffic reporting) ---
GA4_PROPERTY_ID=
GA4_CLIENT_EMAIL=
GA4_PRIVATE_KEY=

# --- Google Search Console API (organic search performance reporting) ---
# Reuses the GA4_CLIENT_EMAIL/GA4_PRIVATE_KEY service account above — just
# add that same service account as a user in Search Console too.
SEARCH_CONSOLE_SITE_URL=

# --- Meta Graph API (optional FB/IG auto-posting + contacts overview) ---
META_PAGE_ACCESS_TOKEN=
META_PAGE_ID=
META_IG_USER_ID=

# --- Lead sourcing tuning (defaults are broad/general, worldwide, any industry/region) ---
LEAD_CATEGORIES=
LEAD_REGIONS=
LEADS_PER_RUN=20
# Distinct category+region searches per run — the main volume lever (each
# search is a billed Places API call, so raise carefully).
LEAD_SEARCHES_PER_RUN=8
# Target emails/day outreach aims for. Not a hard cap — lead-finder checks
# progress against this every run and searches harder when behind pace.
DAILY_EMAIL_TARGET=200

# --- Local dashboard (optional; see "Local dashboard" in README) ---
DASHBOARD_PORT=4040
