# Copy to .env.local for local testing (then `export $(cat .env.local | xargs)`
# or use a tool like `dotenv-cli`). In production these are GitHub Actions
# secrets/variables — see automation/README.md for the full setup checklist.
# Every value here is optional: each agent skips whatever it doesn't have
# credentials for and logs why, instead of crashing.

# --- Identity ---
BUSINESS_NAME=GunaFix
BUSINESS_URL=https://gunafix.com
OWNER_NAME=Marko
OWNER_EMAIL=markoguna9@gmail.com
SENDER_EMAIL=

# --- Anthropic (drafts outreach copy, audit write-ups, social scripts) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_FAST_MODEL=claude-haiku-4-5

# --- GitHub (lead board + run log; GH_TOKEN/GITHUB_REPOSITORY are auto-set in Actions) ---
GH_TOKEN=
GITHUB_REPOSITORY=

# --- Google Places (lead sourcing) ---
GOOGLE_PLACES_API_KEY=

# --- Gmail OAuth2 (outreach drafts + leader urgent emails) ---
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# --- GA4 Data API (traffic reporting) ---
GA4_PROPERTY_ID=
GA4_CLIENT_EMAIL=
GA4_PRIVATE_KEY=

# --- Google Ads API (ads performance reporting) ---
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=

# --- Meta Graph API (optional FB/IG auto-posting + contacts overview) ---
META_PAGE_ACCESS_TOKEN=
META_PAGE_ID=
META_IG_USER_ID=

# --- Lead sourcing tuning (defaults are broad/general, any industry/region) ---
LEAD_CATEGORIES=
LEAD_REGIONS=
LEADS_PER_RUN=15

# --- Local dashboard (optional; see "Local dashboard" in README) ---
DASHBOARD_PORT=4040
